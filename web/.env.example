# Copy to .env.local (ignored by git) and fill in.
# All values are public build-time settings; never put secrets here.

# Public URL of the Mnemora archive (the Streamlit app in ../dhruv-rag).
# Leave empty while the archive is not deployed: the threshold page will say so.
# Examples:
#   VITE_ARCHIVE_URL=https://ask.dhruvbendre.com
#   VITE_ARCHIVE_URL=https://dhruv-archive.streamlit.app
VITE_ARCHIVE_URL=

# Base URL of the archive API (dhruv-rag: `uvicorn api:app --port 8000`).
# Leave empty in development: Vite proxies /api/archive to port 8000.
# Example: VITE_ARCHIVE_API_URL=https://ask.dhruvbendre.com/api
VITE_ARCHIVE_API_URL=

# "false" keeps visitors on the threshold page and only shows a link.
VITE_ARCHIVE_AUTO_ENTER=true

# Development only: draw the coordinate grid, hit areas and orbit ids.
VITE_DEBUG_SOLAR=false
