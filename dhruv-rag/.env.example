# Copy to .env (never committed) and fill in what you use.
# On Streamlit Community Cloud, put the same names in the app's Secrets instead.

# ---- model provider ---------------------------------------------------------
# openai | anthropic | none   (blank = auto: anthropic if its key is set, else openai, else none)
LLM_PROVIDER=

# OpenAI, or any OpenAI-compatible endpoint (set OPENAI_BASE_URL for the latter).
# Groq example (keys start with gsk_):
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   MODEL_NAME=openai/gpt-oss-120b
#   EMBEDDING_PROVIDER=local        (Groq has no embeddings endpoint)
# xAI Grok example: OPENAI_BASE_URL=https://api.x.ai/v1, MODEL_NAME=grok-4, EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic.
ANTHROPIC_API_KEY=

# Chat model. Blank = gpt-4o-mini (openai) or claude-opus-5 (anthropic).
MODEL_NAME=

# ---- embeddings -------------------------------------------------------------
# openai | local   (blank = openai if OPENAI_API_KEY is set, else local)
# "local" is a keyless hashed fallback for development and tests, not a semantic model.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small

# ---- retrieval ----------------------------------------------------------------
RETRIEVAL_TOP_K=5
# Cosine floor below which the archive refuses. Blank = 0.30 (openai) / 0.18 (local).
RETRIEVAL_MIN_SCORE=
MAX_CONTEXT_CHARS=9000
HISTORY_TURNS=6
CONDENSE_FOLLOWUPS=true
MAX_ANSWER_TOKENS=900

# ---- identity -------------------------------------------------------------------
ARCHIVE_NAME=Mnemora
OWNER_NAME=Dhruv Bendre
OWNER_SHORT=Dhruv
ARCHIVE_TAGLINE=Ask the archive about Dhruv.
ARCHIVE_EMPTY_STATE=Ask me anything about Dhruv.
# Where "Back to the system" leads (the main portfolio). Blank hides the link.
PORTFOLIO_URL=

# ---- storage --------------------------------------------------------------------
KNOWLEDGE_DIR=
INDEX_DIR=
# true loads knowledge/_test_data (obviously fictional, TEST_DATA_ONLY). Keep false in production.
INCLUDE_TEST_DATA=false
